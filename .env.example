# Backend
DATABASE_URL=postgresql://postgres:postgres@db:5432/whatsapp_ai
# Rol de base de datos sin BYPASSRLS (ver supabase/migrations/0005_app_role_and_rls.sql),
# usado por las rutas autenticadas del dashboard para que la RLS forzada aplique de verdad.
TENANT_DATABASE_URL=postgresql://app_user:app_user_change_me_in_prod@db:5432/whatsapp_ai
REDIS_URL=redis://redis:6379/0
WEBHOOK_VERIFY_TOKEN=change-me
WHATSAPP_APP_SECRET=change-me
WHATSAPP_ACCESS_TOKEN=change-me
WHATSAPP_GRAPH_VERSION=v23.0
OPENROUTER_API_KEY=change-me
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# API key de Brevo (brevo.com) para enviar códigos de verificación y notificaciones.
BREVO_API_KEY=
# Debe ser un remitente verificado en tu cuenta de Brevo (Senders, Domains & Dedicated IPs
# > Senders) — no requiere dominio propio, solo confirmar un correo por email.
EMAIL_FROM=bot@example.com
# Obligatorio, sin default. Generar con: openssl rand -base64 48
JWT_SECRET=
# Obligatorio, sin default. Clave Fernet para cifrar api_keys en reposo.
# Generar con: openssl rand -base64 32
APP_ENCRYPTION_KEY=
# true solo en desarrollo: siembra una empresa/bot de ejemplo con UUIDs fijos en cada arranque.
# Debe quedar en false (o sin definir) en cualquier entorno con datos reales.
DEMO_MODE=false
# Token para POST /v1/admin/subscriptions/{id}/activate (activación manual de planes
# pagados mientras no hay pasarela de pago). Sin esto, esos endpoints responden 503.
# Generar con: openssl rand -base64 32
PLATFORM_ADMIN_TOKEN=
# A dónde llegan los avisos de "un cliente pidió upgrade de plan" (POST /v1/billing/request-upgrade).
PLATFORM_ADMIN_EMAIL=

# Dashboard
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
